TZ={{ tautulli_environment_variables_tz }}

{# Tautulli reads any of its settings from a `TAUTULLI_<SETTING>` environment variable,
   which takes precedence over the `config.ini` it maintains for itself. #}
TAUTULLI_HTTP_PORT={{ tautulli_container_http_port }}

{# Traefik passes the prefix through rather than stripping it (see `labels.j2`).
   `/` means the root. #}
TAUTULLI_HTTP_ROOT={{ tautulli_path_prefix }}
{% if tautulli_environment_variables_tautulli_http_proxy | bool %}
TAUTULLI_HTTP_PROXY=1
{% endif %}

{{ tautulli_environment_variables_additional_variables }}
