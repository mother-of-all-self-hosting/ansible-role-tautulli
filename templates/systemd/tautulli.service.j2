[Unit]
Description=Tautulli ({{ tautulli_identifier }})
{% for service in tautulli_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in tautulli_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ tautulli_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ tautulli_identifier }} \
      --log-driver=none \
      --user={{ tautulli_uid }}:{{ tautulli_gid }} \
      --cap-drop=ALL \
      --read-only \
      {# The image's own entrypoint needs root, to change the uid of its user and
         the owner of /config before dropping privileges. The container runs as
         the role's user instead, whose data path the role creates, so Tautulli is
         started directly. #}
      --entrypoint=python \
      --network={{ tautulli_container_network }} \
      {% if tautulli_container_http_host_bind_port %}
      -p {{ tautulli_container_http_host_bind_port }}:{{ tautulli_container_http_port }} \
      {% endif %}
      --env-file={{ tautulli_base_path }}/env \
      --label-file={{ tautulli_base_path }}/labels \
      --mount type=bind,src={{ tautulli_data_path }},dst=/config \
      {% for volume in tautulli_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ tautulli_container_tmpfs_tmp_size }} \
      {# The image's health check, at the port the role configures rather than 8181 #}
      --health-cmd='curl -ILfks -o /dev/null https://localhost:{{ tautulli_container_http_port }}/status || curl -ILfs -o /dev/null http://localhost:{{ tautulli_container_http_port }}/status' \
      {% for arg in tautulli_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ tautulli_container_image }} \
      Tautulli.py --datadir /config \
      {% for arg in tautulli_process_extra_arguments %}
      {{ arg }} \
      {% endfor %}

{% for network in tautulli_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ tautulli_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ tautulli_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ tautulli_container_stop_grace_time_seconds }} {{ tautulli_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ tautulli_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ tautulli_identifier }}

[Install]
WantedBy=multi-user.target
